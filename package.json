{
  "name": "agent-purge",
  "version": "0.2.8",
  "description": "One persona, many coding agents: replace or inject system prompts across codex, claude, opencode (v1/v2), grok, omp, hermes, pi, zcode, dsh.",
  "type": "module",
  "bin": {
    "agent-purge": "bin/agent-purge.mjs"
  },
  "files": [
    "bin",
    "lib",
    "backends",
    "web",
    "bench",
    "matrix.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "web": "node bin/agent-purge.mjs web",
    "matrix": "node bin/agent-purge.mjs matrix",
    "detect": "node bin/agent-purge.mjs detect",
    "test": "node magpie-plugin/selftest.mjs && node magpie-plugin/test-page.mjs && node test/harness-adapters.test.mjs && node test/regressions.test.mjs",
    "prepack": "node -e \"require('node:fs').rmSync('personas/.build',{recursive:true,force:true})\""
  },
  "keywords": [
    "system-prompt",
    "codex",
    "claude",
    "opencode",
    "dsh",
    "deepseek-harness",
    "coding-agent",
    "pi",
    "persona",
    "prompt-injection"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZiChuanLan/agent-purge.git"
  },
  "homepage": "https://github.com/ZiChuanLan/agent-purge#readme",
  "bugs": {
    "url": "https://github.com/ZiChuanLan/agent-purge/issues"
  }
}
